# Copy this file to env.properties and fill in your actual values.
# NEVER commit env.properties — it is listed in .gitignore.

# JWT secret (for local auth)
jwt.secret=YOUR_JWT_SECRET
jwt.header=Authorization
jwt.expiration=86400000

# Stripe key
stripe.api.key=YOUR_STRIPE_TEST_API_KEY

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Alert email addresses
ALERT_EMAIL_FROM=no-reply@marketplatform.com
ALERT_EMAIL_ADMIN=admin@marketplatform.com

# Verification link used in signup emails
APP_VERIFICATION_URL=APP_VERIFICATION_URL
# SMTP credentials used by spring.mail.*
SPRING_MAIL_USERNAME=SPRING_MAIL_USERNAME
SPRING_MAIL_PASSWORD=SPRING_MAIL_PASSWORD

